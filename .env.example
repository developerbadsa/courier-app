# ============================================================
# Shohnaat Logistics - Environment Configuration
# ============================================================

# --- Application Environment ---
NODE_ENV=development
PORT=5000
FRONTEND_PORT=3000
API_PREFIX=/api/v1
APP_URL=http://localhost:3000
API_URL=http://localhost:5000

# --- Database (PostgreSQL) ---
# For Docker: postgres://user:password@postgres:5432/dbname
# For Local machine: postgres://user:password@localhost:5432/dbname
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=shohnaat_logistics
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/shohnaat_logistics?schema=public

# --- Cache & Message Queue (Redis & BullMQ) ---
# For Docker: redis://redis:6379
# For Local machine: redis://localhost:6379
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# --- Authentication & JWT ---
JWT_ACCESS_SECRET=shohnaat_super_secure_jwt_access_secret_key_2026
JWT_REFRESH_SECRET=shohnaat_super_secure_jwt_refresh_secret_key_2026
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# --- Strict Currency Setting (USD ONLY - STRICT CLIENT RULE) ---
DEFAULT_CURRENCY=USD
CURRENCY_SYMBOL=$

# --- Payment Gateways (PayPal & Stripe ONLY - STRICT CLIENT RULE) ---
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
PAYPAL_CLIENT_ID=paypal_client_id_placeholder
PAYPAL_CLIENT_SECRET=paypal_secret_placeholder
PAYPAL_MODE=sandbox

# --- Notification Providers (Phase 2 & 3) ---
# WhatsApp Business Solution Provider (BSP) API
WHATSAPP_API_KEY=whatsapp_key_placeholder
WHATSAPP_PHONE_NUMBER_ID=whatsapp_phone_id_placeholder

# SMS Gateway
SMS_API_KEY=sms_key_placeholder
SMS_SENDER_ID=SHOHNAAT

# Email SMTP
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=user_placeholder
SMTP_PASS=pass_placeholder
SMTP_FROM="Shohnaat Logistics <no-reply@shohnaat.com>"
