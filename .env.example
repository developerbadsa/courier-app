# ============================================================
# Shohnaat Logistics - Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# --- Application Environment ---
NODE_ENV=development
PORT=5000
FRONTEND_PORT=3000
API_PREFIX=/api/v1
APP_URL=http://localhost:3000
API_URL=http://localhost:5000

# --- Database (PostgreSQL) ---
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_secure_db_password
POSTGRES_DB=shohnaat_logistics
POSTGRES_PORT=5432
DATABASE_URL=postgresql://your_db_user:your_secure_db_password@db:5432/shohnaat_logistics

# --- Cache & Message Queue (Redis & BullMQ) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# --- Authentication & JWT ---
JWT_ACCESS_SECRET=generate_a_strong_random_string_here
JWT_REFRESH_SECRET=generate_another_strong_random_string_here
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# --- Currency Setting (USD ONLY) ---
DEFAULT_CURRENCY=USD
CURRENCY_SYMBOL=$

# --- Payment Gateways ---
STRIPE_SECRET_KEY=sk_test_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_MODE=sandbox

# --- Notification Providers ---
WHATSAPP_API_KEY=your_whatsapp_key
WHATSAPP_PHONE_NUMBER_ID=your_phone_id
SMS_API_KEY=your_sms_key
SMS_SENDER_ID=SHOHNAAT
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="Shohnaat Logistics <noreply@yourdomain.com>"
