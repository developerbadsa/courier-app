# ============================================================
# Shohnaat Backend — Development Dockerfile
# ============================================================

FROM node:20-alpine
WORKDIR /app

RUN apk add --no-cache openssl libc6-compat

COPY package.json package-lock.json* ./
RUN npm install

COPY . .

RUN npx prisma generate

EXPOSE 5000
EXPOSE 5555

CMD ["npm", "run", "dev"]
